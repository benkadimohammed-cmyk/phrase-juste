rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == "insergent01@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function isValidLearnerProfile(data, userId) {
      return data.keys().hasAll(['uid', 'settingsJson', 'progressJson', 'xp', 'streakDays', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'settingsJson', 'progressJson', 'xp', 'streakDays', 'updatedAt']) &&
        data.uid is string &&
        data.uid == userId &&
        (!('email' in data) || (data.email is string && data.email.size() <= 320)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        data.settingsJson is string &&
        data.settingsJson.size() >= 2 &&
        data.settingsJson.size() <= 10000 &&
        data.progressJson is string &&
        data.progressJson.size() >= 2 &&
        data.progressJson.size() <= 100000 &&
        data.xp is number &&
        data.xp >= 0 &&
        data.xp <= 1000000 &&
        data.streakDays is number &&
        data.streakDays >= 0 &&
        data.streakDays <= 3650 &&
        data.updatedAt is string &&
        data.updatedAt.size() >= 10 &&
        data.updatedAt.size() <= 64;
    }

    // Read-only connectivity check document
    match /_connection_test_/{docId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Per-user learning profile and gamification state
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && isValidLearnerProfile(request.resource.data, userId);
      allow update: if (isOwner(userId) || isAdmin()) &&
        isValidLearnerProfile(request.resource.data, userId) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
