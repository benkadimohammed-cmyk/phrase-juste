rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Hardened Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidLearnerProfile(data, userId) {
      return data.keys().hasAll(['uid', 'settingsJson', 'progressJson', 'xp', 'streakDays', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'settingsJson', 'progressJson', 'xp', 'streakDays', 'updatedAt']) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid == userId &&
        (!('email' in data) || (data.email is string && data.email.size() <= 320)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        data.settingsJson is string &&
        data.settingsJson.size() >= 2 &&
        data.settingsJson.size() <= 10000 &&
        data.progressJson is string &&
        data.progressJson.size() >= 2 &&
        data.progressJson.size() <= 100000 &&
        data.xp is number &&
        data.xp >= 0 &&
        data.xp <= 1000000 &&
        data.streakDays is number &&
        data.streakDays >= 0 &&
        data.streakDays <= 3650 &&
        data.updatedAt is string &&
        data.updatedAt.size() >= 10 &&
        data.updatedAt.size() <= 64;
    }

    // Read-only connectivity check documents
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }

    match /_connection_test_/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }

    // Per-user learning profile and gamification state
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidLearnerProfile(incoming(), userId);
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidLearnerProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'email', 'displayName', 'settingsJson', 'progressJson', 'xp', 'streakDays', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
